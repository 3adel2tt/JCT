# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Discord Configuration
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_CHANNEL_ID=123456789012345678
ADMIN_USER_ID=987654321098765432

# Blockchain & API Configuration
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
GOPLUS_API_KEY=YOUR_GOPLUS_KEY
CHAIN_ID=1

# Security & Trading
# WARNING: NEVER use a main cold wallet. Only use a dedicated hot wallet with limited funds.
SNIPER_WALLET_PRIVATE_KEY=0x...
SMART_WALLETS=0xWallet1,0xWallet2,0xWallet3
